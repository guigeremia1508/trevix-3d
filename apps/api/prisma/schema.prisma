generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ProjectType {
  COMERCIAL
  PESSOAL
  PROTOTIPO
  ESCOLAR
  ROBOTICA
  EXPERIMENTAL
}

enum ProjectStatus {
  PLANEJAMENTO
  ORCAMENTO
  APROVADO
  EM_PRODUCAO
  CONCLUIDO
  CANCELADO
}

enum PrintStatus {
  PLANEJADA
  IMPRIMINDO
  CONCLUIDA
  FALHOU
  CANCELADA
}

enum OrderStatus {
  ORCAMENTO
  PENDENTE
  CONFIRMADO
  EM_PRODUCAO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum TransactionType {
  RECEITA
  DESPESA
  INVESTIMENTO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  CONSUMO
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects     Project[]
  prints       Print[]
  transactions FinancialTransaction[]
  auditLogs    AuditLog[]
}

model Client {
  id     Int     @id @default(autoincrement())
  name   String
  email  String?
  phone  String?
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  quotes   Quote[]
  orders   Order[]
}

model Printer {
  id           Int     @id @default(autoincrement())
  name         String
  model        String?
  serialNumber String? @unique
  active       Boolean @default(true)

  totalPrintSeconds Int     @default(0)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prints      Print[]
  maintenance Maintenance[]
}

model Filament {
  id         Int     @id @default(autoincrement())
  brand      String
  material   String
  color      String
  diameterMm Float   @default(1.75)
  pricePerKg Decimal @db.Decimal(10, 2)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolls FilamentRoll[]
}

model FilamentRoll {
  id         Int @id @default(autoincrement())
  filamentId Int

  code           String? @unique
  initialGrams   Int
  remainingGrams Int
  costCents      Int
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filament       Filament        @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  rollId    Int
  type      StockMovementType
  grams     Int
  reason    String?
  projectId Int?
  printId   Int?

  createdAt DateTime @default(now())

  roll    FilamentRoll @relation(fields: [rollId], references: [id], onDelete: Restrict)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  print   Print?       @relation(fields: [printId], references: [id], onDelete: SetNull)

  @@index([rollId])
  @@index([projectId])
  @@index([printId])
}

model Project {
  id     Int           @id @default(autoincrement())
  name   String
  type   ProjectType
  status ProjectStatus @default(PLANEJAMENTO)

  description      String?
  estimatedSeconds Int?
  estimatedGrams   Int?

  clientId Int?
  userId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  prints         Print[]
  stockMovements StockMovement[]
  quotes         Quote[]
  orderItems     OrderItem[]
}

model Print {
  id        Int @id @default(autoincrement())
  projectId Int
  printerId Int
  userId    Int

  status PrintStatus @default(PLANEJADA)

  estimatedSeconds Int?
  actualSeconds    Int?
  estimatedGrams   Int?
  actualGrams      Int?
  wasteGrams       Int  @default(0)

  materialCostCents Int?
  energyCostCents   Int?
  machineCostCents  Int?
  totalCostCents    Int?

  settings String?
  result   String?
  notes    String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]

  @@index([projectId])
  @@index([printerId])
  @@index([userId])
}

model Quote {
  id        Int  @id @default(autoincrement())
  clientId  Int?
  projectId Int?

  materialCents    Int @default(0)
  energyCents      Int @default(0)
  machineCents     Int @default(0)
  laborCents       Int @default(0)
  packagingCents   Int @default(0)
  freightCents     Int @default(0)
  finishingCents   Int @default(0)
  developmentCents Int @default(0)
  otherCents       Int @default(0)

  totalCostCents Int @default(0)
  priceCents     Int @default(0)
  marginCents    Int @default(0)

  validUntil DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  order Order?
}

model Order {
  id       Int  @id @default(autoincrement())
  clientId Int?
  quoteId  Int? @unique

  status OrderStatus @default(PENDENTE)

  totalCents Int     @default(0)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quote  Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  items        OrderItem[]
  transactions FinancialTransaction[]
}

model OrderItem {
  id        Int  @id @default(autoincrement())
  orderId   Int
  projectId Int?

  description String
  quantity    Int    @default(1)
  unitCents   Int
  totalCents  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model FinancialTransaction {
  id          Int             @id @default(autoincrement())
  type        TransactionType
  amountCents Int
  description String
  category    String?

  orderId Int?
  userId  Int

  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([createdAt])
  @@index([orderId])
}

model Maintenance {
  id        Int @id @default(autoincrement())
  printerId Int

  description String
  costCents   Int     @default(0)
  notes       String?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id       Int     @id @default(autoincrement())
  userId   Int
  action   String
  entity   String
  entityId Int?
  details  String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
